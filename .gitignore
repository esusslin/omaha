# secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# data — raw documents and vectors stay local
data/
*.db

# ...except the gold set. It's the evaluation spec, not data: no secrets, a few KB,
# and `make eval` is unrunnable without it. Raw fetched club HTML stays out — 39 MB
# of someone else's copyrighted pages has no business in a public repo.
!data/gold/
!data/gold/**
*.sqlite
*.parquet
*.duckdb

# model caches
.cache/
models/
*.safetensors
*.bin

# python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/
build/

# node (Phase 8)
node_modules/
ui/dist/

# os / editor
.DS_Store
.idea/
.vscode/
!.vscode/extensions.json

# logs
logs/
*.log
